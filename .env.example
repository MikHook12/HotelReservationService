# Copy to .env and replace both passwords before starting infrastructure.
DB_HOST=localhost
DB_PORT=5433
DB_NAME=hotel_db
DB_USER=hotel_user
DB_PASSWORD=replace-with-a-long-random-database-password
MONGO_HOST=localhost
MONGO_PORT=27017
MONGO_DB=hotel_statistics
MONGO_USER=hotel_stats
MONGO_PASSWORD=replace-with-a-different-long-random-password
KAFKA_BOOTSTRAP_SERVERS=localhost:9092

# Enable only for the first administrator creation, then disable and remove password.
BOOTSTRAP_ADMIN_ENABLED=false
BOOTSTRAP_ADMIN_NAME=
BOOTSTRAP_ADMIN_EMAIL=
BOOTSTRAP_ADMIN_PASSWORD=
