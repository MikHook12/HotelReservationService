# Server-only. Never prefix these with NEXT_PUBLIC_. No credentials in the URL.
BROWSER_BACKEND_ORIGIN=http://127.0.0.1:8080
# Exact external origin; no trailing slash or path.
PUBLIC_ORIGIN=http://127.0.0.1:3000
# Local development only; both origins must be loopback.
LOCAL_HTTP_MODE=1
# QA fixtures are opt-in, loopback-only and never enabled in production.
FRONTEND_QA_MODE=0
