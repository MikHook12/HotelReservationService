{
  "name": "hotel-reservation-web",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev --hostname 127.0.0.1",
    "build": "next build --webpack",
    "start": "next start --hostname 127.0.0.1",
    "typecheck": "tsc --noEmit",
    "test": "tsx --test tests/*.test.ts",
    "generate:api": "openapi-typescript ../docs/api/openapi.json -o src/lib/api-schema.d.ts",
    "cert:local": "node scripts/create-local-cert.mjs",
    "dev:isolated": "node scripts/live-preview.mjs",
    "local:start": "node ../scripts/local.mjs start",
    "local:stop": "node ../scripts/local.mjs stop",
    "local:status": "node ../scripts/local.mjs status"
  },
  "engines": {
    "node": ">=22.0.0"
  },
  "dependencies": {
    "next": "16.4.2",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "server-only": "0.0.1"
  },
  "devDependencies": {
    "@types/node": "26.6.5",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "openapi-typescript": "7.13.0",
    "tsx": "4.23.15",
    "typescript": "5.9.3"
  }
}
